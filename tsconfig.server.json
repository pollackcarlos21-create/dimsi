{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "miniprogram-api-typings"],
    "noEmit": true
  },
  "include": [
    "cloudfunctions/api/src/**/*.ts",
    "miniprogram/types/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "cloudfunctions/api/index.js"]
}
