# 仅在云函数环境变量中配置，切勿写入小程序端或提交到 Git。
# DeepSeek 官方 OpenAI 兼容接口
DEEPSEEK_API_KEY=sk-your-server-side-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 未配置 DeepSeek Key 时，云函数默认进入服务端演示模式。
# AI_MOCK_MODE=true 可强制演示模式；生产环境建议显式设为 false。
AI_MOCK_MODE=false

# 腾讯云语音合成（TTS）
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TTS_REGION=ap-beijing
TTS_VOICE_TYPE=101001
# 预留粤语声音；未配置时粤语合成会返回 TTS_UNAVAILABLE，不影响普通话。
TTS_VOICE_TYPE_CANTONESE=
TTS_ENDPOINT=https://tts.tencentcloudapi.com
TTS_CODEC=mp3
TTS_SAMPLE_RATE=16000

# 配额与超时（单位：次 / 毫秒）
DAILY_UPLOAD_LIMIT=30
DAILY_ANALYSIS_LIMIT=20
DAILY_CHAT_LIMIT=60
DAILY_TTS_LIMIT=40
AI_TIMEOUT_MS=30000
TTS_TIMEOUT_MS=12000
MAX_IMAGE_BYTES=5242880
# 分析结束后立即删除原图；如未来启用留存，必须配置清理任务。
DELETE_IMAGE_AFTER_ANALYSIS=true

# 管理后台/定时清理用的共享密钥（仅服务端；留空则禁用清理入口）
MAINTENANCE_SECRET=
# 日志中用户引用的哈希盐；生产环境请设置随机值
LOG_HASH_PEPPER=
