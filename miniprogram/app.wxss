page {
  --bg: #f8f7f4;
  --surface: #fffefc;
  --surface-soft: #f2f0ea;
  --ink: #242424;
  --ink-soft: #56534d;
  --muted: #837f76;
  --line: #e8e4dc;
  --accent: #547a65;
  --accent-strong: #436450;
  --accent-soft: #e7eee9;
  --warm: #d99b66;
  --warm-soft: #f7ecdf;
  --danger: #a34d43;
  --danger-soft: #f7e8e5;
  --radius-lg: 32rpx;
  --radius-md: 24rpx;
  --shadow-soft: 0 12rpx 40rpx rgba(73, 66, 52, 0.06);

  min-height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page--center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.muted {
  color: var(--muted);
}

.ink-soft {
  color: var(--ink-soft);
}

.small {
  font-size: 26rpx;
}

.tiny {
  font-size: 23rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.btn:active {
  opacity: 0.82;
  transform: scale(0.99);
}

.btn-primary {
  background: var(--accent);
  color: #ffffff;
}

.btn-secondary {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

.btn-ghost {
  background: transparent;
  color: var(--accent);
}

.btn-small {
  min-height: 72rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 23rpx;
  font-weight: 500;
}

.pill--warm {
  background: var(--warm-soft);
  color: #8b5c32;
}

.pill--demo {
  background: var(--warm-soft);
  color: #8b5c32;
  border: 1rpx dashed rgba(139, 92, 50, 0.28);
}

.hairline {
  height: 1rpx;
  background: var(--line);
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.demo-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(139, 92, 50, 0.3);
  border-radius: 20rpx;
  background: var(--warm-soft);
  color: #7a542f;
  font-size: 24rpx;
  line-height: 1.45;
}

.demo-banner__dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--warm);
}

.loading-dots {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.loading-dots__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.28;
  animation: dot-pulse 1.4s ease-in-out infinite;
}

.loading-dots__dot:nth-child(2) {
  animation-delay: 0.18s;
}

.loading-dots__dot:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes dot-pulse {
  0%,
  80%,
  100% {
    opacity: 0.24;
    transform: translateY(0);
  }
  40% {
    opacity: 0.9;
    transform: translateY(-5rpx);
  }
}

.input {
  width: 100%;
  height: 96rpx;
  padding: 0 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 30rpx;
}

.placeholder {
  color: #a19c92;
}

.link {
  color: var(--accent);
  font-weight: 500;
}

.divider {
  margin: 24rpx 0;
  height: 1rpx;
  background: var(--line);
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
