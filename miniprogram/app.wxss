page {
  --bg: #ffffff;
  --surface: #ffffff;
  --surface-soft: #f6f6f6;
  --surface-faint: #fafafa;
  --ink: #202124;
  --ink-soft: #5f6368;
  --muted: #8a8a8a;
  --faint: #b0b0b0;
  --danger: #b3261e;
  --danger-soft: #fdf5f4;
  --radius-sm: 40rpx;
  --radius-md: 48rpx;
  --radius-lg: 56rpx;
  --radius-xl: 64rpx;
  --shadow-near: 0 4rpx 24rpx rgba(0, 0, 0, 0.035);
  --shadow-soft: 0 8rpx 48rpx rgba(0, 0, 0, 0.035),
    0 24rpx 96rpx rgba(0, 0, 0, 0.025);
  --ease: cubic-bezier(0.22, 1, 0.36, 1);

  min-height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view,
text,
button,
input,
textarea,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: 0;
}

input,
textarea {
  font-family: inherit;
}

image {
  display: block;
}

.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  animation: page-in 280ms var(--ease) both;
}

@keyframes page-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: transform 160ms var(--ease), opacity 160ms var(--ease);
}

.btn:active,
.btn--pressed {
  transform: scale(0.985);
  opacity: 0.88;
}

.btn-primary {
  background: var(--ink);
  color: #ffffff;
}

.btn-secondary {
  background: var(--surface-soft);
  color: var(--ink);
}

.btn-ghost {
  background: transparent;
  color: var(--muted);
  font-weight: 500;
}

.btn-small {
  min-height: 84rpx;
  padding: 0 30rpx;
  border-radius: 40rpx;
  font-size: 27rpx;
}

.demo-banner {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 40rpx;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.loading-dots {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.loading-dots__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink);
  opacity: 0.22;
  animation: dot-pulse 1.3s ease-in-out infinite;
}

.loading-dots__dot:nth-child(2) {
  animation-delay: 0.16s;
}

.loading-dots__dot:nth-child(3) {
  animation-delay: 0.32s;
}

@keyframes dot-pulse {
  0%,
  80%,
  100% {
    opacity: 0.18;
    transform: translateY(0);
  }
  40% {
    opacity: 0.72;
    transform: translateY(-4rpx);
  }
}

.placeholder {
  color: var(--faint);
}
