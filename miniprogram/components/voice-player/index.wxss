button::after {
  border: 0;
}

.voice {
  padding: 26rpx;
  border: 1rpx solid #dce7df;
  border-radius: 30rpx;
  background: #eef4f0;
}

.voice__main {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 106rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
  gap: 20rpx;
}

.voice__main--pressed {
  opacity: 0.86;
}

.voice__icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #547a65;
}

.voice__icon--loading {
  background: #6d8e7b;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #ffffff;
}

.pause-bars {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.pause-bars__bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #ffffff;
}

.voice__copy {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.voice__title {
  color: #274234;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.voice__hint {
  margin-top: 4rpx;
  color: #6e8376;
  font-size: 22rpx;
  line-height: 1.4;
}

.voice__speed {
  flex: 0 0 auto;
  min-width: 76rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(84, 122, 101, 0.28);
  border-radius: 999rpx;
  color: #436450;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.voice__error {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #f7e8e5;
  color: #8f4138;
  font-size: 24rpx;
  line-height: 1.5;
}

.voice__note {
  margin-top: 14rpx;
  color: #7c8c81;
  font-size: 21rpx;
  line-height: 1.45;
}

.loading-dots {
  display: flex;
  gap: 6rpx;
}

.loading-dots__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.4;
  animation: voice-dot 1.2s ease-in-out infinite;
}

.loading-dots__dot:nth-child(2) {
  animation-delay: 0.15s;
}

.loading-dots__dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes voice-dot {
  0%,
  80%,
  100% {
    opacity: 0.35;
  }
  40% {
    opacity: 1;
  }
}
