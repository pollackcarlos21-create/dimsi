button::after {
  border: 0;
}

.voice {
  padding: 8rpx;
  border-radius: 56rpx;
  background: #f6f6f6;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.voice__main {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 116rpx;
  gap: 20rpx;
  margin: 0;
  padding: 20rpx 22rpx;
  border: 0;
  border-radius: 48rpx;
  background: transparent;
  color: inherit;
  line-height: normal;
  transition: opacity 160ms ease;
}

.voice__main--pressed {
  opacity: 0.82;
}

.voice__main[disabled] {
  opacity: 1;
}

.voice__play {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #202124;
}

.play-triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #ffffff;
}

.pause-bars {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.pause-bars__bar {
  width: 7rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #ffffff;
}

.voice__dots {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.voice__dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.45;
  animation: voice-dot 1.2s ease-in-out infinite;
}

.voice__dot:nth-child(2) {
  animation-delay: 0.14s;
}

.voice__dot:nth-child(3) {
  animation-delay: 0.28s;
}

@keyframes voice-dot {
  0%,
  80%,
  100% {
    opacity: 0.35;
  }
  40% {
    opacity: 1;
  }
}

.voice__copy {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.voice__title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.voice__hint {
  margin-top: 4rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.4;
}

.voice__speed {
  flex: 0 0 auto;
  min-width: 74rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8a8a8a;
  font-size: 21rpx;
  font-weight: 500;
  text-align: center;
}

.voice__error {
  margin: 4rpx 20rpx 16rpx;
  color: #b3261e;
  font-size: 23rpx;
  line-height: 1.5;
}
