<view class="voice">
  <button
    class="voice__main"
    hover-class="voice__main--pressed"
    bindtap="onToggle"
    disabled="{{status === 'loading'}}"
    aria-label="朗读这餐建议"
  >
    <view class="voice__play">
      <view wx:if="{{status === 'loading'}}" class="voice__dots">
        <view class="voice__dot"></view>
        <view class="voice__dot"></view>
        <view class="voice__dot"></view>
      </view>
      <view wx:elif="{{status === 'playing'}}" class="pause-bars">
        <view class="pause-bars__bar"></view>
        <view class="pause-bars__bar"></view>
      </view>
      <view wx:else class="play-triangle"></view>
    </view>

    <view class="voice__copy">
      <view class="voice__title">
        <block wx:if="{{status === 'loading'}}">正在生成…</block>
        <block wx:elif="{{status === 'playing'}}">正在朗读</block>
        <block wx:elif="{{status === 'paused'}}">已暂停</block>
        <block wx:elif="{{status === 'ended'}}">重新播放</block>
        <block wx:elif="{{status === 'error'}}">再试一次</block>
        <block wx:else>听一听</block>
      </view>
      <view class="voice__hint">
        <block wx:if="{{status === 'loading'}}">请稍候</block>
        <block wx:elif="{{status === 'playing'}}">轻触暂停</block>
        <block wx:elif="{{status === 'paused'}}">轻触继续</block>
        <block wx:elif="{{status === 'ended'}}">轻触重播</block>
        <block wx:elif="{{status === 'error'}}">文字内容不受影响</block>
        <block wx:else>本餐建议</block>
      </view>
    </view>

    <view class="voice__speed" catchtap="onCycleRate" aria-role="button" aria-label="切换朗读语速">
      {{rateLabel}}
    </view>
  </button>

  <view wx:if="{{error}}" class="voice__error">{{error}}</view>
</view>
