.badge {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f6f6f6;
  color: #8a8a8a;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
