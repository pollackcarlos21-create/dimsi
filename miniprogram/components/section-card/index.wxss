.section-card {
  padding: 36rpx 32rpx 40rpx;
  border-radius: 56rpx;
  background: #f6f6f6;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.section-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-card__heading {
  flex: 1;
  min-width: 0;
}

.section-card__title {
  color: #202124;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.section-card__subtitle {
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1.5;
}
