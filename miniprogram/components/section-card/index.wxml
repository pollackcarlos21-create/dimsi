<view class="section-card">
  <view wx:if="{{title || subtitle}}" class="section-card__head">
    <view class="section-card__heading">
      <view wx:if="{{title}}" class="section-card__title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="section-card__subtitle">{{subtitle}}</view>
    </view>
    <slot name="extra"></slot>
  </view>
  <slot></slot>
</view>
