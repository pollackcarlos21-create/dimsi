.row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 28rpx;
  animation: bubble-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes bubble-in {
  from {
    opacity: 0;
    transform: translateY(6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.row--user {
  align-items: flex-end;
}

.bubble {
  max-width: 82%;
  padding: 24rpx 28rpx;
  border-radius: 36rpx;
  background: #f6f6f6;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 29rpx;
  line-height: 1.6;
}

.bubble--user {
  background: #202124;
  color: #ffffff;
}

.bubble__text {
  white-space: pre-wrap;
  word-break: break-word;
}

.demo-tag {
  margin: 8rpx 10rpx 0;
  color: #b0b0b0;
  font-size: 22rpx;
  font-weight: 500;
}
