button::after {
  border: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx 96rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  text-align: center;
}

.empty__title {
  color: #202124;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
}

.empty__desc {
  max-width: 520rpx;
  margin-top: 16rpx;
  color: #8a8a8a;
  font-size: 27rpx;
  line-height: 1.65;
}

.empty__action {
  min-width: 260rpx;
  min-height: 92rpx;
  margin: 40rpx 0 0;
  padding: 0 36rpx;
  border: 0;
  border-radius: 46rpx;
  background: #202124;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.empty__action:active {
  opacity: 0.86;
}
