button::after {
  border: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 64rpx;
  text-align: center;
}

.empty__art {
  position: relative;
  width: 170rpx;
  height: 130rpx;
  margin-bottom: 30rpx;
}

.empty__bowl {
  position: absolute;
  left: 14rpx;
  bottom: 0;
  width: 142rpx;
  height: 78rpx;
  border: 6rpx solid #9aae9f;
  border-top: 0;
  border-radius: 0 0 90rpx 90rpx;
  background: #e7eee9;
}

.empty__bowl::after {
  content: "";
  position: absolute;
  left: -20rpx;
  top: -6rpx;
  width: 176rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #547a65;
}

.empty__leaf {
  position: absolute;
  width: 34rpx;
  height: 56rpx;
  border-radius: 100% 0 100% 0;
  background: #d99b66;
  opacity: 0.72;
}

.empty__leaf--one {
  top: 10rpx;
  left: 62rpx;
  transform: rotate(-22deg);
}

.empty__leaf--two {
  top: 26rpx;
  left: 98rpx;
  transform: rotate(30deg) scale(0.8);
}

.empty__title {
  color: #242424;
  font-size: 32rpx;
  font-weight: 600;
}

.empty__desc {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #837f76;
  font-size: 26rpx;
  line-height: 1.55;
}

.empty__action {
  min-width: 240rpx;
  min-height: 84rpx;
  margin: 30rpx 0 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  background: #547a65;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}
