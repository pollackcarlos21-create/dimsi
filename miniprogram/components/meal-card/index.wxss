.meal-card {
  margin-bottom: 20rpx;
  padding: 30rpx 32rpx;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.035),
    0 16rpx 64rpx rgba(0, 0, 0, 0.02);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  transition: transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.meal-card--pressed {
  transform: scale(0.988);
}

.meal-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.meal-card__meta {
  color: #8a8a8a;
  font-size: 23rpx;
  font-weight: 500;
}

.meal-card__name {
  margin-top: 12rpx;
  color: #202124;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.meal-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.meal-card__numbers {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  min-width: 0;
}

.meal-card__value {
  color: #202124;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.meal-card__unit {
  margin-left: 6rpx;
  color: #b0b0b0;
  font-size: 22rpx;
}

.meal-card__dot {
  margin: 0 12rpx;
  color: #d0d0d0;
  font-size: 22rpx;
}

.meal-card__protein {
  color: #8a8a8a;
  font-size: 24rpx;
}

.meal-card__arrow {
  flex: 0 0 auto;
  color: #b0b0b0;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}
