<view class="page correction-page">
  <view wx:if="{{state === 'loading'}}" class="correction-state">
    <view class="loading-dots">
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
    </view>
    <text>正在加载…</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="correction-state correction-state--error">
    <view class="correction-state__title">无法调整</view>
    <view class="correction-state__text">{{error}}</view>
    <button class="btn btn-secondary btn-small" bindtap="onRetry">重试</button>
    <button class="correction-cancel" bindtap="onCancel">返回</button>
  </view>

  <block wx:else>
    <view class="correction-head">
      <view class="correction-head__top">
        <view class="correction-title">修改食物</view>
        <demo-badge source="{{source}}" />
      </view>
      <view class="correction-sub">改名称或份量，保存后重新估算。</view>
    </view>

    <view class="food-list">
      <view wx:for="{{foods}}" wx:key="key" class="food-edit">
        <view class="food-edit__top">
          <input
            class="food-name"
            value="{{item.name}}"
            data-index="{{index}}"
            bindinput="onNameInput"
            maxlength="30"
            placeholder="食物名称"
            placeholder-class="placeholder"
          />
          <button
            class="remove-food"
            data-index="{{index}}"
            catchtap="onRemoveFood"
            aria-label="删除这一项"
          >×</button>
        </view>

        <view class="portion-row">
          <text class="portion-label">份量</text>
          <button class="stepper" data-index="{{index}}" data-delta="-10" catchtap="onAdjustPortion">−</button>
          <view class="portion-field">
            <input
              class="portion-input"
              type="number"
              value="{{item.portionText}}"
              data-index="{{index}}"
              bindinput="onPortionInput"
              maxlength="4"
            />
            <text class="portion-unit">克</text>
          </view>
          <button class="stepper" data-index="{{index}}" data-delta="10" catchtap="onAdjustPortion">+</button>
        </view>
      </view>
    </view>

    <button wx:if="{{foods.length < 12}}" class="add-food" bindtap="onAddFood">
      <text class="add-food__plus">＋</text>
      <text>添加食物</text>
    </button>

    <view class="save-note">份量按可食部估算。</view>

    <view class="correction-actions">
      <button class="btn btn-primary" bindtap="onSave" disabled="{{busy}}">
        {{busy ? '保存中…' : '保存'}}
      </button>
      <button class="correction-cancel" bindtap="onCancel">取消</button>
    </view>
  </block>
</view>
