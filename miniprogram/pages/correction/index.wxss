.correction-page {
  padding-top: 24rpx;
}

.correction-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 18rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  text-align: center;
}

.correction-state__title {
  color: #202124;
  font-size: 34rpx;
  font-weight: 600;
}

.correction-state__text {
  max-width: 520rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 1.6;
}

.correction-state--error .correction-state__title {
  color: #b3261e;
}

.correction-head {
  padding: 4rpx 2rpx 0;
}

.correction-head__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.correction-title {
  color: #202124;
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: -1.2rpx;
}

.correction-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 26rpx;
  line-height: 1.5;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.food-edit {
  padding: 26rpx;
  border-radius: 48rpx;
  background: #f6f6f6;
}

.food-edit__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.food-name {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  color: #202124;
  font-size: 29rpx;
  font-weight: 500;
  background: transparent;
}

.remove-food {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #b0b0b0;
  font-size: 36rpx;
  line-height: 80rpx;
  text-align: center;
}

.remove-food:active {
  opacity: 0.5;
}

.portion-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.portion-label {
  margin-right: auto;
  color: #8a8a8a;
  font-size: 22rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #202124;
  font-size: 32rpx;
  line-height: 80rpx;
  transition: transform 150ms ease, opacity 150ms ease;
}

.stepper:active {
  transform: scale(0.94);
  opacity: 0.7;
}

.portion-field {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 16rpx;
  border-radius: 40rpx;
  background: #ffffff;
}

.portion-input {
  width: 82rpx;
  height: 80rpx;
  color: #202124;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.portion-unit {
  color: #b0b0b0;
  font-size: 21rpx;
}

.add-food {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  border-radius: 44rpx;
  background: #fafafa;
  color: #5f6368;
  font-size: 25rpx;
  font-weight: 500;
}

.add-food:active {
  opacity: 0.65;
}

.add-food__plus {
  color: #8a8a8a;
  font-size: 28rpx;
}

.save-note {
  margin: 22rpx 4rpx 0;
  color: #b0b0b0;
  font-size: 22rpx;
  line-height: 1.5;
}

.correction-actions {
  margin-top: 28rpx;
}

.correction-cancel {
  width: 100%;
  min-height: 80rpx;
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 80rpx;
  text-align: center;
}

.correction-cancel:active {
  opacity: 0.56;
}
