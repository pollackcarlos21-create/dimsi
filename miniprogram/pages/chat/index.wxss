.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f7f4;
}

.chat-head {
  flex: 0 0 auto;
  padding: 28rpx 32rpx 18rpx;
}

.chat-head__eyebrow {
  color: #8a867d;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.chat-head__title {
  margin-top: 8rpx;
  color: #242424;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.chat-head__sub {
  margin-top: 8rpx;
  color: #77736a;
  font-size: 24rpx;
  line-height: 1.55;
}

.demo-banner {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-start;
  gap: 14rpx;
  margin: 0 32rpx 14rpx;
  padding: 18rpx 22rpx;
  border: 1rpx dashed rgba(139, 92, 50, 0.3);
  border-radius: 18rpx;
  background: #f7ecdf;
  color: #7a542f;
  font-size: 22rpx;
  line-height: 1.5;
}

.demo-banner__dot {
  flex: 0 0 auto;
  width: 11rpx;
  height: 11rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d99b66;
}

.consent-banner {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 16rpx;
  margin: 0 32rpx 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4e9e5;
  border-radius: 18rpx;
  background: #f2f5f2;
}

.consent-banner__copy {
  flex: 1;
  min-width: 0;
}

.consent-banner__title {
  color: #4e5d53;
  font-size: 23rpx;
  font-weight: 600;
}

.consent-banner__text {
  margin-top: 3rpx;
  color: #7d887f;
  font-size: 20rpx;
  line-height: 1.45;
}

.consent-banner__action {
  flex: 0 0 auto;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #dfe9e2;
  color: #436450;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.chat-loading,
.chat-error {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 40rpx;
  color: #837f76;
  font-size: 25rpx;
  text-align: center;
}

.chat-error__title {
  color: #3b3833;
  font-size: 31rpx;
  font-weight: 600;
}

.chat-error__text {
  max-width: 520rpx;
  color: #837f76;
  line-height: 1.6;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-messages {
  padding: 16rpx 32rpx 24rpx;
}

.chat-bottom {
  height: 2rpx;
}

.typing {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.typing__avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e7eee9;
  color: #436450;
  font-size: 25rpx;
  font-weight: 600;
}

.typing__bubble {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e8e4dc;
  border-radius: 8rpx 26rpx 26rpx 26rpx;
  background: #fffefc;
}

.typing__text {
  color: #8a867d;
  font-size: 23rpx;
}

.composer {
  flex: 0 0 auto;
  padding: 10rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eae6de;
  background: rgba(248, 247, 244, 0.98);
}

.presets {
  width: 100%;
  white-space: nowrap;
}

.presets__inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 6rpx 14rpx;
}

.preset {
  flex: 0 0 auto;
  min-height: 70rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e4e0d8;
  border-radius: 999rpx;
  background: #fffefc;
  color: #5c5851;
  font-size: 22rpx;
  line-height: 70rpx;
}

.preset[disabled] {
  color: #aaa49a;
  opacity: 0.6;
}

.composer__box {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 12rpx 12rpx 12rpx 22rpx;
  border: 1rpx solid #e1ddd4;
  border-radius: 28rpx;
  background: #fffefc;
}

.composer__input {
  flex: 1;
  min-width: 0;
  min-height: 58rpx;
  max-height: 200rpx;
  padding: 10rpx 0;
  color: #34312c;
  font-size: 28rpx;
  line-height: 1.5;
}

.send-btn {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8e4dc;
}

.send-btn--active {
  background: #547a65;
}

.send-arrow {
  width: 15rpx;
  height: 15rpx;
  border-top: 4rpx solid #aaa49a;
  border-right: 4rpx solid #aaa49a;
  transform: rotate(45deg) translate(-2rpx, 2rpx);
}

.send-btn--active .send-arrow {
  border-color: #ffffff;
}

.composer__foot {
  margin-top: 10rpx;
  padding: 0 8rpx;
  color: #a09b92;
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}
