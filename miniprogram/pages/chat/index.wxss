.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
}

.chat-top-note {
  flex: 0 0 auto;
  padding: 20rpx 40rpx 0;
  color: #b0b0b0;
  font-size: 22rpx;
  text-align: center;
}

.consent-line {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 20rpx 40rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 36rpx;
  background: #fafafa;
}

.consent-line__text {
  color: #8a8a8a;
  font-size: 23rpx;
}

.consent-line__action {
  flex: 0 0 auto;
  min-height: 76rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #202124;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.chat-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.chat-state__title {
  color: #202124;
  font-size: 34rpx;
  font-weight: 600;
}

.chat-state__text {
  max-width: 520rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 1.6;
}

.chat-state__retry {
  margin-top: 8rpx;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-messages {
  padding: 32rpx 40rpx 20rpx;
}

.chat-empty {
  width: auto;
  margin-right: -40rpx;
  margin-left: -40rpx;
  padding: 72rpx 0 20rpx;
  text-align: center;
}

.chat-empty__title {
  color: #202124;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.quick-list {
  margin-top: 40rpx;
  margin-right: 40rpx;
  margin-left: 40rpx;
}

.quick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  margin-bottom: 12rpx;
  padding: 0 26rpx;
  border-radius: 40rpx;
  background: #fafafa;
  color: #5f6368;
  font-size: 26rpx;
  text-align: left;
  transition: opacity 160ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.quick-item--pressed {
  opacity: 0.7;
  transform: scale(0.99);
}

.quick-item__arrow {
  color: #c8c8c8;
  font-size: 30rpx;
  font-weight: 300;
}

.typing {
  display: flex;
  margin-bottom: 24rpx;
}

.typing__bubble {
  padding: 22rpx 26rpx;
  border-radius: 36rpx;
  background: #f6f6f6;
}

.chat-bottom {
  height: 2rpx;
}

.composer {
  flex: 0 0 auto;
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.composer__box {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 112rpx;
  padding: 10rpx 10rpx 10rpx 26rpx;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(32, 33, 36, 0.03),
    0 10rpx 30rpx rgba(32, 33, 36, 0.045),
    0 24rpx 64rpx rgba(32, 33, 36, 0.03);
}

.composer__input {
  flex: 1;
  min-width: 0;
  min-height: 60rpx;
  max-height: 200rpx;
  padding: 12rpx 0;
  color: #202124;
  font-size: 28rpx;
  line-height: 1.5;
  background: transparent;
}

.send-btn {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: 50%;
  background: #f0f0f0;
  transition: background 160ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.send-btn--active {
  background: #202124;
}

.send-btn:active {
  transform: scale(0.95);
}

.send-arrow {
  position: relative;
  width: 28rpx;
  height: 30rpx;
}

.send-arrow__head {
  position: absolute;
  top: 0;
  left: 50%;
  width: 0;
  height: 0;
  border-right: 9rpx solid transparent;
  border-bottom: 13rpx solid #b0b0b0;
  border-left: 9rpx solid transparent;
  transform: translateX(-50%);
}

.send-arrow__stem {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 4rpx;
  height: 17rpx;
  border-radius: 2rpx;
  background: #b0b0b0;
  transform: translateX(-50%);
}

.send-btn--active .send-arrow__head {
  border-bottom-color: #ffffff;
}

.send-btn--active .send-arrow__stem {
  background: #ffffff;
}

.composer__foot {
  margin-top: 10rpx;
  color: #b0b0b0;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}
