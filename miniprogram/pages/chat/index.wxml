<view class="chat-page">
  <view wx:if="{{isDemo || hasMock}}" class="chat-top-note">
    演示回复 · 不代表真实 AI
  </view>

  <view
    wx:if="{{profileLoaded && !allowHistory && !isDemo}}"
    class="consent-line"
  >
    <text class="consent-line__text">参考最近饮食？</text>
    <button class="consent-line__action" bindtap="onAllowHistory" disabled="{{consentBusy}}">
      {{consentBusy ? '开启中' : '允许'}}
    </button>
  </view>

  <view wx:if="{{loading}}" class="chat-state">
    <view class="loading-dots">
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
    </view>
    <text class="chat-state__text">正在加载…</text>
  </view>

  <view wx:elif="{{error}}" class="chat-state">
    <view class="chat-state__title">连接失败</view>
    <view class="chat-state__text">{{error}}</view>
    <button class="btn btn-secondary btn-small chat-state__retry" bindtap="onRetry">重试</button>
  </view>

  <scroll-view
    wx:else
    class="chat-scroll"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollIntoView}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="chat-messages">
      <view wx:if="{{messages.length === 0}}" class="chat-empty">
        <view class="chat-empty__title">今天想聊点什么？</view>
        <view class="quick-list">
          <button
            wx:for="{{presets}}"
            wx:key="*this"
            class="quick-item"
            hover-class="quick-item--pressed"
            data-question="{{item}}"
            bindtap="onPresetTap"
            disabled="{{sending || !loaded}}"
          >
            <text>{{item}}</text>
            <text class="quick-item__arrow">›</text>
          </button>
        </view>
      </view>

      <chat-bubble wx:for="{{messages}}" wx:key="id" message="{{item}}" />

      <view wx:if="{{sending}}" class="typing">
        <view class="typing__bubble">
          <view class="loading-dots">
            <view class="loading-dots__dot"></view>
            <view class="loading-dots__dot"></view>
            <view class="loading-dots__dot"></view>
          </view>
        </view>
      </view>
      <view id="chat-bottom" class="chat-bottom"></view>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="composer__box">
      <textarea
        class="composer__input"
        value="{{input}}"
        maxlength="500"
        auto-height
        placeholder="问点什么…"
        placeholder-class="placeholder"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        cursor-spacing="24"
        adjust-position
        disabled="{{!loaded}}"
        show-confirm-bar="{{false}}"
      />
      <button
        class="send-btn {{canSend ? 'send-btn--active' : ''}}"
        bindtap="onSend"
        disabled="{{!canSend}}"
        aria-label="发送消息"
      >
        <view class="send-arrow"></view>
      </button>
    </view>
    <view class="composer__foot">一般饮食信息，不替代医疗建议</view>
  </view>
</view>
