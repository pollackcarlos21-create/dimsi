.settings-page {
  padding-top: 24rpx;
}

.settings-group {
  margin-bottom: 20rpx;
  padding: 32rpx 30rpx;
  border-radius: 56rpx;
  background: #f6f6f6;
}

.group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.group-heading {
  flex: 1;
  min-width: 0;
}

.group-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.group-sub {
  margin-top: 4rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.4;
}

.profile-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
}

.profile-state--error {
  justify-content: space-between;
  gap: 20rpx;
}

.profile-error {
  flex: 1;
  min-width: 0;
  color: #b3261e;
  font-size: 23rpx;
  line-height: 1.5;
}

.profile-retry {
  flex: 0 0 auto;
  color: #202124;
  font-size: 23rpx;
  font-weight: 600;
}

.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 90rpx;
}

.select-row__label {
  color: #202124;
  font-size: 26rpx;
}

.select-row__value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8a8a8a;
  font-size: 25rpx;
}

.chevron {
  color: #c8c8c8;
  font-size: 30rpx;
  font-weight: 300;
}

.field-group {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.choice-tag {
  min-height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5f6368;
  font-size: 24rpx;
  line-height: 80rpx;
  transition: background 160ms ease, color 160ms ease;
}

.choice-tag--active {
  background: #202124;
  color: #ffffff;
  font-weight: 500;
}

.allergy-input {
  width: 100%;
  height: 88rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 40rpx;
  background: #ffffff;
  color: #202124;
  font-size: 25rpx;
}

.field-hint {
  margin-top: 10rpx;
  color: #b0b0b0;
  font-size: 22rpx;
  line-height: 1.5;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.switch-title {
  color: #202124;
  font-size: 25rpx;
  font-weight: 500;
}

.switch-desc {
  margin-top: 4rpx;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.5;
}

.settings-save {
  width: 100%;
  margin-top: 26rpx;
}

.speed-options {
  display: flex;
  gap: 10rpx;
}

.speed-option {
  flex: 1;
  min-height: 94rpx;
  padding: 14rpx 8rpx;
  border-radius: 40rpx;
  background: #ffffff;
  text-align: center;
  transition: background 160ms ease, color 160ms ease;
}

.speed-option--active {
  background: #202124;
}

.speed-option__label {
  display: block;
  color: #5f6368;
  font-size: 23rpx;
}

.speed-option--active .speed-option__label {
  color: #ffffff;
  font-weight: 600;
}

.speed-option__value {
  display: block;
  margin-top: 2rpx;
  color: #b0b0b0;
  font-size: 20rpx;
}

.speed-option--active .speed-option__value {
  color: #d0d0d0;
}

.privacy-lines {
  margin-top: 18rpx;
}

.privacy-line {
  color: #5f6368;
  font-size: 23rpx;
  line-height: 1.65;
}

.privacy-line + .privacy-line {
  margin-top: 8rpx;
}

.delete-button {
  width: 100%;
  min-height: 84rpx;
  margin-top: 22rpx;
  color: #b3261e;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 84rpx;
  text-align: left;
}

.delete-button:active {
  opacity: 0.6;
}

.diagnostics-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 20rpx;
  text-align: left;
}

.disclosure-action {
  flex: 0 0 auto;
  color: #8a8a8a;
  font-size: 23rpx;
}

.diagnostics-body {
  margin-top: 22rpx;
}

.diag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
}

.diag-label {
  color: #8a8a8a;
  font-size: 23rpx;
}

.diag-value {
  color: #202124;
  font-size: 23rpx;
  font-weight: 500;
}

.diag-error {
  margin-top: 8rpx;
  color: #b3261e;
  font-size: 21rpx;
  line-height: 1.5;
}

.diag-note {
  margin-top: 10rpx;
  color: #b0b0b0;
  font-size: 20rpx;
  line-height: 1.6;
}

.about {
  padding: 24rpx 8rpx 20rpx;
}

.about-title {
  color: #8a8a8a;
  font-size: 22rpx;
  font-weight: 500;
}

.about-text {
  margin-top: 10rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.6;
}

.about-meta {
  margin-top: 16rpx;
  color: #c8c8c8;
  font-size: 20rpx;
}
