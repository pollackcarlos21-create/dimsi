<view class="page settings-page">
  <view wx:if="{{isDemo}}" class="demo-banner">演示模式 · 数据仅保存在本机</view>

  <view class="settings-group">
    <view class="group-head">
      <view class="group-heading">
        <view class="group-title">个人资料</view>
        <view class="group-sub">可选，不影响拍照</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="profile-state">
      <view class="loading-dots">
        <view class="loading-dots__dot"></view>
        <view class="loading-dots__dot"></view>
        <view class="loading-dots__dot"></view>
      </view>
    </view>

    <view wx:elif="{{profileError && !profileLoaded}}" class="profile-state profile-state--error">
      <text class="profile-error">{{profileError}}</text>
      <text class="profile-retry" bindtap="onRetryProfile">重试</text>
    </view>

    <block wx:else>
      <picker mode="selector" range="{{ageOptions}}" value="{{ageIndex}}" bindchange="onAgeChange">
        <view class="select-row">
          <text class="select-row__label">年龄</text>
          <view class="select-row__value">{{ageOptions[ageIndex]}}<text class="chevron">›</text></view>
        </view>
      </picker>

      <picker mode="selector" range="{{activityOptions}}" value="{{activityIndex}}" bindchange="onActivityChange">
        <view class="select-row">
          <text class="select-row__label">活动量</text>
          <view class="select-row__value">{{activityOptions[activityIndex]}}<text class="chevron">›</text></view>
        </view>
      </picker>

      <view class="field-group">
        <view class="field-label">饮食目标</view>
        <view class="tag-wrap">
          <button
            wx:for="{{goals}}"
            wx:key="label"
            class="choice-tag {{item.selected ? 'choice-tag--active' : ''}}"
            data-label="{{item.label}}"
            bindtap="onToggleGoal"
          >{{item.label}}</button>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">口味偏好</view>
        <view class="tag-wrap">
          <button
            wx:for="{{preferences}}"
            wx:key="label"
            class="choice-tag {{item.selected ? 'choice-tag--active' : ''}}"
            data-label="{{item.label}}"
            bindtap="onTogglePreference"
          >{{item.label}}</button>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">食物过敏</view>
        <input
          class="allergy-input"
          value="{{allergies}}"
          placeholder="例如：花生"
          placeholder-class="placeholder"
          maxlength="80"
          bindinput="onAllergiesInput"
        />
        <view class="field-hint">请勿填写病历或检查资料。</view>
      </view>

      <view class="switch-row">
        <view class="switch-copy">
          <view class="switch-title">参考最近饮食</view>
          <view class="switch-desc">仅最近三天摘要，不使用照片</view>
        </view>
        <switch checked="{{allowHistory}}" color="#202124" bindchange="onHistoryChange" />
      </view>

      <button class="btn btn-primary settings-save" bindtap="onSaveProfile" disabled="{{saving}}">
        {{saving ? '保存中…' : '保存'}}
      </button>
    </block>
  </view>

  <view class="settings-group">
    <view class="group-head">
      <view class="group-heading">
        <view class="group-title">朗读</view>
        <view class="group-sub">下次朗读生效</view>
      </view>
    </view>
    <view class="speed-options">
      <button
        wx:for="{{speedOptions}}"
        wx:key="value"
        class="speed-option {{item.selected ? 'speed-option--active' : ''}}"
        data-speed="{{item.value}}"
        bindtap="onSpeedSelect"
      >
        <text class="speed-option__label">{{item.label}}</text>
        <text class="speed-option__value">{{item.value}}×</text>
      </button>
    </view>
  </view>

  <view class="settings-group">
    <view class="group-title">数据与隐私</view>
    <view class="privacy-lines">
      <view class="privacy-line">原图分析后删除，记录中不保存照片。</view>
      <view class="privacy-line">数据按微信身份隔离。</view>
      <view class="privacy-line">清空后保留匿名每日用量，次日失效。</view>
    </view>
    <button class="delete-button" bindtap="onDeleteAll" disabled="{{deleting}}">
      {{deleting ? '正在清空…' : '清空全部数据'}}
    </button>
  </view>

  <view class="settings-group">
    <button class="diagnostics-toggle" bindtap="onToggleDiagnostics">
      <view class="group-heading">
        <view class="group-title">运行诊断</view>
        <view class="group-sub">仅保存在本机</view>
      </view>
      <text class="disclosure-action">{{showDiagnostics ? '收起' : '展开'}}</text>
    </button>

    <view wx:if="{{showDiagnostics}}" class="diagnostics-body">
      <view class="diag-row">
        <text class="diag-label">运行模式</text>
        <text class="diag-value">{{modeLabel}}</text>
      </view>
      <view class="diag-row">
        <text class="diag-label">AI 服务</text>
        <text class="diag-value">{{health ? (health.aiMode === 'mock' ? '演示' : '已配置') : '未检测'}}</text>
      </view>
      <view class="diag-row">
        <text class="diag-label">语音服务</text>
        <text class="diag-value">{{health ? (health.ttsConfigured ? '已配置' : '未配置') : '未检测'}}</text>
      </view>
      <view wx:if="{{healthError}}" class="diag-error">{{healthError}}</view>
      <view class="diag-note">{{latestAnalysisText}}</view>
      <view class="diag-note">{{latestTtsText}}</view>
    </view>
  </view>

  <view class="about">
    <view class="about-title">关于</view>
    <view class="about-text">营养数据为区间估算，仅作日常参考，不用于诊断或治疗。</view>
    <view class="about-text">数据来源：中国居民膳食指南、中国食物成分数据、USDA FoodData Central。</view>
    <view class="about-meta">版本 {{version}}</view>
  </view>
</view>
