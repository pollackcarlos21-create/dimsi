<view class="page meals-page">
  <view class="meals-top">
    <text class="meals-date">{{dateLabel}}</text>
    <text wx:if="{{isDemo || hasMock}}" class="meals-mode">演示数据</text>
  </view>

  <view wx:if="{{isDemo || hasMock}}" class="demo-banner meals-demo">
    演示数据 · 不代表真实分析
  </view>

  <view wx:if="{{loading}}" class="skeleton-list">
    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line--short"></view>
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line skeleton-line--short"></view>
      <view class="skeleton-line skeleton-line--title"></view>
      <view class="skeleton-line skeleton-line--meta"></view>
    </view>
  </view>

  <view wx:elif="{{error}}" class="meals-error">
    <view class="meals-error__text">{{error}}</view>
    <button class="meals-error__retry" bindtap="onRetry">重试</button>
  </view>

  <empty-state
    wx:elif="{{meals.length === 0}}"
    title="今天还没有记录"
    description="拍一张，看看这顿饭。"
    action-text="拍照"
    bind:action="onCapture"
  />

  <block wx:else>
    <view class="summary">
      <view class="summary__head">
        <text class="summary__title">今日估算</text>
        <text class="summary__count">{{summary.count}} 餐</text>
      </view>
      <view class="summary__grid">
        <view class="summary__cell">
          <view class="summary__label">热量</view>
          <view class="summary__value">{{summary.calories}}</view>
          <view class="summary__unit">千卡</view>
        </view>
        <view class="summary__cell summary__cell--center">
          <view class="summary__label">蛋白质</view>
          <view class="summary__value">{{summary.protein}}</view>
          <view class="summary__unit">克</view>
        </view>
        <view class="summary__cell summary__cell--right">
          <view class="summary__label">脂肪</view>
          <view class="summary__value">{{summary.fat}}</view>
          <view class="summary__unit">克</view>
        </view>
      </view>
      <view class="summary__note">区间估算，仅供日常参考。</view>
    </view>

    <view class="section-label">记录</view>
    <meal-card
      wx:for="{{meals}}"
      wx:key="id"
      meal="{{item}}"
      bind:select="onOpenMeal"
    />

    <button class="add-meal" hover-class="add-meal--pressed" bindtap="onCapture">
      <text class="add-meal__plus">＋</text>
      <text>记录一餐</text>
    </button>
  </block>

  <view class="privacy-foot">记录仅自己可见。照片分析后删除。</view>
</view>
