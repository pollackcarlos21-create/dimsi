.meals-page {
  padding-top: 24rpx;
}

.meals-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.meals-date {
  color: #8a8a8a;
  font-size: 24rpx;
  font-weight: 500;
}

.meals-mode {
  color: #b0b0b0;
  font-size: 22rpx;
}

.meals-demo {
  margin-top: 22rpx;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.skeleton-card {
  padding: 30rpx 32rpx;
  border-radius: 48rpx;
  background: #fafafa;
}

.skeleton-line {
  height: 18rpx;
  border-radius: 8rpx;
  background: #ededed;
  animation: skeleton-breathe 1.5s ease-in-out infinite;
}

.skeleton-line--short {
  width: 24%;
  height: 14rpx;
}

.skeleton-line--title {
  width: 46%;
  height: 28rpx;
  margin-top: 18rpx;
}

.skeleton-line--meta {
  width: 66%;
  margin-top: 18rpx;
}

@keyframes skeleton-breathe {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.meals-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 26rpx 28rpx;
  border-radius: 44rpx;
  background: #fdf5f4;
}

.meals-error__text {
  flex: 1;
  min-width: 0;
  color: #b3261e;
  font-size: 24rpx;
  line-height: 1.55;
}

.meals-error__retry {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #202124;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 64rpx;
}

.summary {
  margin-top: 30rpx;
  padding: 34rpx 30rpx 30rpx;
  border-radius: 56rpx;
  background: #f6f6f6;
}

.summary__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary__title {
  color: #202124;
  font-size: 27rpx;
  font-weight: 600;
}

.summary__count {
  color: #8a8a8a;
  font-size: 22rpx;
}

.summary__grid {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.summary__cell {
  flex: 1;
  min-width: 0;
}

.summary__cell--center {
  text-align: center;
}

.summary__cell--right {
  text-align: right;
}

.summary__label {
  color: #8a8a8a;
  font-size: 22rpx;
}

.summary__value {
  margin-top: 8rpx;
  color: #202124;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1.5rpx;
}

.summary__unit {
  margin-top: 4rpx;
  color: #b0b0b0;
  font-size: 20rpx;
}

.summary__note {
  margin-top: 24rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
}

.section-label {
  margin: 42rpx 4rpx 18rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.add-meal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-height: 96rpx;
  margin-top: 10rpx;
  border-radius: 48rpx;
  background: #f6f6f6;
  color: #5f6368;
  font-size: 26rpx;
  font-weight: 500;
  transition: opacity 160ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}

.add-meal--pressed {
  opacity: 0.7;
  transform: scale(0.99);
}

.add-meal__plus {
  color: #8a8a8a;
  font-size: 30rpx;
}

.privacy-foot {
  margin-top: 48rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}
