.meals-page {
  padding-top: 34rpx;
}

.meals-head {
  padding: 8rpx 4rpx 30rpx;
}

.meals-title {
  margin-top: 10rpx;
  color: #242424;
  font-size: 50rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.meals-sub {
  margin-top: 12rpx;
  color: #77736a;
  font-size: 26rpx;
  line-height: 1.55;
}

.demo-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(139, 92, 50, 0.3);
  border-radius: 20rpx;
  background: #f7ecdf;
  color: #7a542f;
  font-size: 23rpx;
  line-height: 1.5;
}

.demo-banner__dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 11rpx;
  border-radius: 50%;
  background: #d99b66;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.skeleton-card {
  padding: 28rpx;
  border: 1rpx solid #eae6de;
  border-radius: 28rpx;
  background: #fffefc;
}

.skeleton-line {
  height: 20rpx;
  border-radius: 8rpx;
  background: #efede7;
  animation: skeleton 1.4s ease-in-out infinite;
}

.skeleton-line--short {
  width: 24%;
  height: 16rpx;
}

.skeleton-line--title {
  width: 48%;
  height: 30rpx;
  margin-top: 18rpx;
}

.skeleton-line--meta {
  width: 68%;
  margin-top: 18rpx;
}

@keyframes skeleton {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.error-card {
  padding: 32rpx;
  border: 1rpx solid #ecd8d3;
  border-radius: 28rpx;
  background: #fcf6f4;
}

.error-card__title {
  color: #533d38;
  font-size: 29rpx;
  font-weight: 600;
}

.error-card__message {
  margin-top: 10rpx;
  color: #8a6e67;
  font-size: 25rpx;
  line-height: 1.55;
}

.error-card .btn {
  margin-top: 22rpx;
}

.summary-card {
  padding: 30rpx;
  border: 1rpx solid #dce7df;
  border-radius: 32rpx;
  background: #eef3ef;
}

.summary-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-card__title {
  color: #2f4036;
  font-size: 29rpx;
  font-weight: 600;
}

.summary-card__sub {
  margin-top: 5rpx;
  color: #728478;
  font-size: 22rpx;
}

.summary-card__count {
  color: #547a65;
  font-size: 45rpx;
  font-weight: 600;
  line-height: 1;
}

.summary-grid {
  display: flex;
  margin-top: 26rpx;
}

.summary-cell {
  flex: 1;
  min-width: 0;
}

.summary-cell--center {
  padding: 0 22rpx;
  border-left: 1rpx solid rgba(84, 122, 101, 0.18);
  border-right: 1rpx solid rgba(84, 122, 101, 0.18);
  text-align: center;
}

.summary-cell--right {
  text-align: right;
}

.summary-cell__label {
  color: #728478;
  font-size: 22rpx;
}

.summary-cell__value {
  margin-top: 6rpx;
  color: #2f4036;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.summary-cell__unit {
  margin-top: 2rpx;
  color: #7c8c81;
  font-size: 20rpx;
}

.summary-card__note {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(84, 122, 101, 0.16);
  color: #728478;
  font-size: 21rpx;
  line-height: 1.5;
}

.meals-section {
  margin-top: 36rpx;
}

.meals-section__title {
  margin-bottom: 16rpx;
  padding-left: 4rpx;
  color: #3b3833;
  font-size: 29rpx;
  font-weight: 600;
}

.add-meal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  min-height: 92rpx;
  margin-top: 8rpx;
  border: 2rpx dashed #dcd7ce;
  border-radius: 24rpx;
  color: #5e7b69;
  font-size: 25rpx;
}

.add-meal__plus {
  font-size: 30rpx;
}

.privacy-foot {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 10rpx;
  margin-top: 44rpx;
  padding: 0 20rpx;
  color: #a09b92;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: center;
}

.privacy-foot__dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #b9c6bd;
}
