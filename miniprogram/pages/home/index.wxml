<view class="page home">
  <view class="home-copy">
    <view class="home-title">今天吃了什么</view>
    <view class="home-sub">拍张照片看看</view>
  </view>

  <view class="home-main">
    <button
      class="shutter"
      hover-class="shutter--pressed"
      hover-stay-time="60"
      bindtap="onCamera"
      aria-label="拍照看看"
    >
      <view class="rainbow rainbow--red" aria-hidden="true"></view>
      <view class="rainbow rainbow--orange" aria-hidden="true"></view>
      <view class="rainbow rainbow--yellow" aria-hidden="true"></view>
      <view class="rainbow rainbow--green" aria-hidden="true"></view>
      <view class="rainbow rainbow--blue" aria-hidden="true"></view>
      <view class="rainbow rainbow--purple" aria-hidden="true"></view>
      <view class="shutter__face" aria-hidden="true">
        <view class="camera">
          <view class="camera__top"></view>
          <view class="camera__lens"></view>
        </view>
      </view>
    </button>

    <button
      class="album"
      hover-class="album--pressed"
      bindtap="onAlbum"
      aria-label="从相册选择"
    >
      从相册选择
    </button>
  </view>

  <view class="home-secondary">
    <button class="home-tile" hover-class="home-tile--pressed" bindtap="onViewToday">
      <view class="tile-icon" aria-hidden="true">
        <view class="calendar-icon">
          <view class="calendar-icon__top"></view>
          <view class="calendar-icon__dot calendar-icon__dot--left"></view>
          <view class="calendar-icon__dot calendar-icon__dot--right"></view>
        </view>
      </view>
      <view class="home-tile__copy">
        <text class="home-tile__title">今天的记录</text>
        <text wx:if="{{summaryLoading}}" class="home-tile__meta">正在加载</text>
        <text wx:elif="{{summary}}" class="home-tile__meta">{{summary.count}} 餐 · {{summary.calories}} 千卡</text>
        <text wx:elif="{{loadError}}" class="home-tile__meta">点击查看</text>
        <text wx:else class="home-tile__meta">还没有记录</text>
      </view>
      <text class="home-tile__arrow">›</text>
    </button>

    <button class="home-tile" hover-class="home-tile--pressed" bindtap="onOpenChat">
      <view class="tile-icon" aria-hidden="true">
        <view class="chat-icon">
          <view class="chat-icon__dot"></view>
          <view class="chat-icon__dot"></view>
          <view class="chat-icon__dot"></view>
        </view>
      </view>
      <view class="home-tile__copy">
        <text class="home-tile__title">问问助手</text>
      </view>
      <text class="home-tile__arrow">›</text>
    </button>
  </view>

  <view class="home-footer">
    <text wx:if="{{isDemo || hasMock}}" class="home-mode">
      {{isDemo ? '演示模式' : '含演示数据'}}
    </text>
    <text class="home-privacy">照片仅用于当次分析，完成后删除。</text>
  </view>
</view>
