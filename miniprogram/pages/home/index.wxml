<view class="page home">
  <view class="topline">
    <view class="brand">
      <view class="brand__mark">知</view>
      <text class="brand__name">知食</text>
    </view>
    <view wx:if="{{isDemo || hasMock}}" class="demo-pill">{{isDemo ? '演示模式' : '含演示数据'}}</view>
  </view>

  <view class="hello">{{greeting}} · {{dateLabel}}</view>
  <view class="headline">今天吃了什么？</view>
  <view class="supporting">拍张照片，看看这顿饭吃得怎么样。</view>

  <button
    class="capture"
    hover-class="capture--pressed"
    bindtap="onCamera"
    aria-label="拍照看看"
  >
    <view class="capture__decor capture__decor--one"></view>
    <view class="capture__decor capture__decor--two"></view>
    <view class="capture__icon">
      <view class="camera">
        <view class="camera__top"></view>
        <view class="camera__lens"></view>
      </view>
    </view>
    <view class="capture__copy">
      <view class="capture__title">拍照看看</view>
      <view class="capture__hint">把饭菜放在画面里，拍一张就好</view>
    </view>
    <view class="capture__arrow">›</view>
  </button>

  <button
    class="album"
    hover-class="album--pressed"
    bindtap="onAlbum"
    aria-label="从相册选择"
  >
    <view class="album__icon">
      <view class="album__sun"></view>
      <view class="album__hill"></view>
    </view>
    <text>从相册选择</text>
  </button>

  <view wx:if="{{summaryLoading}}" class="today-line today-line--loading">
    <view class="skeleton-line"></view>
  </view>

  <view wx:elif="{{loadError}}" class="load-error">
    <text>{{loadError}}</text>
    <text class="load-error__retry" bindtap="onRetrySummary">重试</text>
  </view>

  <button
    wx:elif="{{summary}}"
    class="today-line"
    hover-class="today-line--pressed"
    bindtap="onViewToday"
  >
    <view class="today-line__left">
      <view class="today-line__dot"></view>
      <text>今天已记录 {{summary.count}} 餐</text>
    </view>
    <text class="today-line__meta">{{summary.calories}} 千卡 · 蛋白质 {{summary.protein}} 克</text>
    <view class="today-line__arrow">›</view>
  </button>

  <view wx:else class="today-line today-line--empty">
    <text>今天还没有记录，拍下第一餐吧。</text>
  </view>

  <view class="quiet-link" bindtap="onOpenChat">
    <text>想问问吃什么、怎么搭配？</text>
    <text class="quiet-link__action">去问助手 ›</text>
  </view>

  <view class="privacy-note">
    <view class="privacy-note__icon"></view>
    <text>照片只用于分析这顿饭，分析完成后会删除原图。</text>
  </view>
</view>
