<view class="page home">
  <view class="home-copy">
    <view class="home-title">今天吃了什么？</view>
    <view class="home-sub">拍张照片，看看。</view>
  </view>

  <view class="home-main">
    <button
      class="shutter"
      hover-class="shutter--pressed"
      hover-stay-time="60"
      bindtap="onCamera"
      aria-label="拍照看看"
    >
      <view class="camera">
        <view class="camera__top"></view>
        <view class="camera__lens"></view>
      </view>
    </button>

    <button
      class="album"
      hover-class="album--pressed"
      bindtap="onAlbum"
      aria-label="从相册选择"
    >
      从相册选择
    </button>
  </view>

  <view class="home-secondary">
    <view wx:if="{{summaryLoading}}" class="home-skeleton"></view>

    <view wx:elif="{{loadError}}" class="home-error">
      <text>{{loadError}}</text>
      <text class="home-error__retry" bindtap="onRetrySummary">重试</text>
    </view>

    <button
      wx:elif="{{summary}}"
      class="home-link"
      hover-class="home-link--pressed"
      bindtap="onViewToday"
    >
      <view class="home-link__main">
        <text>今天</text>
        <text class="home-link__dot">·</text>
        <text>{{summary.count}} 餐</text>
      </view>
      <text class="home-link__meta">{{summary.calories}} 千卡</text>
      <text class="home-link__arrow">›</text>
    </button>

    <view wx:else class="home-link home-link--empty">
      <text>今天还没有记录</text>
    </view>

    <button class="home-chat" hover-class="home-chat--pressed" bindtap="onOpenChat">
      <text>问问助手</text>
      <text class="home-chat__arrow">›</text>
    </button>
  </view>

  <view class="home-footer">
    <text wx:if="{{isDemo || hasMock}}" class="home-mode">
      {{isDemo ? '演示模式' : '含演示数据'}}
    </text>
    <text class="home-privacy">照片仅用于当次分析，完成后删除。</text>
  </view>
</view>
