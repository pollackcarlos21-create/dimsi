.home {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 24rpx;
}

.home-copy {
  margin-top: 24rpx;
}

.home-title {
  color: #202124;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.24;
  letter-spacing: -2.5rpx;
}

.home-sub {
  margin-top: 18rpx;
  color: #8a8a8a;
  font-size: 30rpx;
  line-height: 1.5;
}

.home-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
}

.shutter {
  display: flex;
  flex: 0 0 280rpx;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  min-width: 280rpx;
  max-width: 280rpx;
  height: 280rpx;
  min-height: 280rpx;
  max-height: 280rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #9cb8d2;
  color: #ffffff;
  box-shadow: 0 18rpx 56rpx rgba(121, 150, 181, 0.2),
    0 48rpx 120rpx rgba(121, 150, 181, 0.1);
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 180ms ease;
}

.shutter--pressed {
  transform: scale(0.96);
  box-shadow: 0 10rpx 36rpx rgba(121, 150, 181, 0.18),
    0 28rpx 72rpx rgba(121, 150, 181, 0.08);
}

.camera {
  position: relative;
  width: 70rpx;
  height: 52rpx;
  border: 4rpx solid #ffffff;
  border-radius: 14rpx;
}

.camera__top {
  position: absolute;
  top: -16rpx;
  left: 17rpx;
  width: 28rpx;
  height: 13rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}

.camera__lens {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.album {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: 96rpx;
  margin-top: 32rpx;
  padding: 0 36rpx;
  background: transparent;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 96rpx;
  text-align: center;
  transition: opacity 160ms ease;
}

.album--pressed {
  opacity: 0.56;
}

.home-secondary {
  margin-top: auto;
  padding-top: 96rpx;
}

.home-skeleton {
  height: 84rpx;
  border-radius: 40rpx;
  background: #fafafa;
  animation: home-breathe 1.5s ease-in-out infinite;
}

@keyframes home-breathe {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.home-link {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 8rpx;
  color: #5f6368;
  font-size: 25rpx;
  text-align: left;
  transition: opacity 160ms ease;
}

.home-link--pressed {
  opacity: 0.6;
}

.home-link--empty {
  color: #8a8a8a;
}

.home-link__main {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.home-link__dot {
  margin: 0 10rpx;
  color: #b0b0b0;
}

.home-link__meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  color: #8a8a8a;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-link__arrow {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #b0b0b0;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.home-chat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 84rpx;
  padding: 0 8rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  transition: opacity 160ms ease;
}

.home-chat--pressed {
  opacity: 0.56;
}

.home-chat__arrow {
  color: #b0b0b0;
  font-size: 30rpx;
  font-weight: 300;
}

.home-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 40rpx;
  background: #fdf5f4;
  color: #b3261e;
  font-size: 23rpx;
  line-height: 1.5;
}

.home-error__retry {
  flex: 0 0 auto;
  font-weight: 600;
}

.home-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.home-mode {
  color: #b0b0b0;
  font-size: 22rpx;
}

.home-privacy {
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-height: 680px) {
  .home-copy {
    margin-top: 8rpx;
  }

  .home-main {
    margin-top: 80rpx;
  }

  .home-secondary {
    padding-top: 48rpx;
  }
}
