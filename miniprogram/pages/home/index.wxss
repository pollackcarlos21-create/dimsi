.home {
  display: flex;
  flex-direction: column;
  padding-top: 24rpx;
}

.home-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.home-date {
  color: #8a8a8a;
  font-size: 24rpx;
  font-weight: 500;
}

.home-mode {
  color: #b0b0b0;
  font-size: 22rpx;
}

.home-copy {
  margin-top: 76rpx;
}

.home-title {
  color: #202124;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.24;
  letter-spacing: -2.5rpx;
}

.home-sub {
  margin-top: 18rpx;
  color: #8a8a8a;
  font-size: 30rpx;
  line-height: 1.5;
}

.home-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 76rpx;
}

.shutter {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: #202124;
  color: #ffffff;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.11),
    0 36rpx 120rpx rgba(0, 0, 0, 0.05);
  transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 180ms ease;
}

.shutter--pressed {
  transform: scale(0.97);
  opacity: 0.92;
}

.camera {
  position: relative;
  width: 72rpx;
  height: 54rpx;
  border: 4rpx solid #ffffff;
  border-radius: 14rpx;
}

.camera__top {
  position: absolute;
  top: -16rpx;
  left: 17rpx;
  width: 30rpx;
  height: 13rpx;
  border: 4rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}

.camera__lens {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.shutter__label {
  margin-top: 30rpx;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.album {
  min-height: 88rpx;
  margin-top: 34rpx;
  padding: 0 28rpx;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 88rpx;
  transition: opacity 160ms ease;
}

.album--pressed {
  opacity: 0.56;
}

.home-secondary {
  margin-top: auto;
  padding-top: 72rpx;
}

.home-skeleton {
  height: 92rpx;
  border-radius: 40rpx;
  background: #fafafa;
  animation: home-breathe 1.5s ease-in-out infinite;
}

@keyframes home-breathe {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.home-link {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 92rpx;
  padding: 0 26rpx;
  border-radius: 40rpx;
  background: #fafafa;
  color: #202124;
  font-size: 26rpx;
  text-align: left;
  transition: opacity 160ms ease;
}

.home-link--pressed {
  opacity: 0.68;
}

.home-link--empty {
  color: #8a8a8a;
}

.home-link__main {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.home-link__dot {
  margin: 0 10rpx;
  color: #b0b0b0;
}

.home-link__meta {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  color: #8a8a8a;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-link__arrow {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #b0b0b0;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.home-chat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 84rpx;
  margin-top: 8rpx;
  padding: 0 26rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  transition: opacity 160ms ease;
}

.home-chat--pressed {
  opacity: 0.56;
}

.home-chat__arrow {
  color: #b0b0b0;
  font-size: 30rpx;
  font-weight: 300;
}

.home-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  background: #fdf5f4;
  color: #b3261e;
  font-size: 23rpx;
  line-height: 1.5;
}

.home-error__retry {
  flex: 0 0 auto;
  font-weight: 600;
}

.home-privacy {
  margin-top: 28rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-height: 680px) {
  .home-copy {
    margin-top: 52rpx;
  }

  .home-main {
    margin-top: 52rpx;
  }

  .shutter {
    width: 300rpx;
    height: 300rpx;
  }

  .home-secondary {
    padding-top: 40rpx;
  }
}
