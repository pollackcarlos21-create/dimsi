<view class="page capture-page">
  <view wx:if="{{state !== 'loading'}}" class="capture-copy">
    <view class="capture-title">
      {{state === 'ready' ? '这张可以吗？' : state === 'error' ? '需要换一张' : '把饭菜拍全'}}
    </view>
    <view class="capture-sub">
      {{state === 'ready' ? '确认后开始分析。' : '光线亮一点，尽量拍全。'}}
    </view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="photo-state">
    <view class="loading-dots">
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
    </view>
    <text class="photo-state__title">处理中…</text>
  </view>

  <view wx:elif="{{state === 'ready' && imagePath}}" class="photo-wrap">
    <image
      class="photo"
      src="{{imagePath}}"
      mode="aspectFill"
      bindtap="onPreview"
      aria-label="预览已选择照片"
    />
  </view>

  <view wx:elif="{{state === 'error'}}" class="photo-state photo-state--error">
    <text class="photo-state__title">{{error}}</text>
    <text wx:if="{{hint}}" class="photo-state__desc">{{hint}}</text>
    <view class="error-actions">
      <button class="btn btn-secondary" bindtap="onRetry">再选一次</button>
      <button wx:if="{{errorIsPrivacy}}" class="btn btn-ghost" bindtap="onOpenPrivacyContract">查看隐私指引</button>
      <button wx:if="{{showPermissionSettings}}" class="btn btn-ghost" bindtap="onPermissionHelp">打开权限设置</button>
    </view>
  </view>

  <view wx:else class="photo-state">
    <text class="photo-state__title">还没有照片</text>
    <text class="photo-state__desc">{{hint || '拍一张，或从相册选择。'}}</text>
    <view class="error-actions">
      <button class="btn btn-primary" bindtap="onTakePhoto">打开相机</button>
      <button class="btn btn-secondary" bindtap="onChooseAlbum">从相册选择</button>
    </view>
  </view>

  <view wx:if="{{state === 'ready'}}" class="actions">
    <button
      class="btn btn-primary analyze-btn"
      bindtap="onAnalyze"
      hover-class="btn--pressed"
      disabled="{{submitting}}"
    >
      {{submitting ? '请稍候…' : '开始分析'}}
    </button>
    <button class="retake" bindtap="onRetakeChoice">重新选择</button>
  </view>

  <view class="capture-privacy">照片仅用于当次分析，完成后删除。</view>

  <view wx:if="{{privacyNeeded}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-sheet">
      <view class="privacy-sheet__title">使用照片</view>
      <view class="privacy-sheet__text">
        需要相机或相册来获取食物照片。照片只用于当次分析，完成后删除原图。
      </view>
      <button class="privacy-sheet__link" bindtap="onOpenPrivacyContract">
        查看《{{privacyContractName || '小程序隐私保护指引'}}》
      </button>
      <button
        id="agree-privacy-btn"
        class="btn btn-primary privacy-sheet__agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onPrivacyAgree"
      >同意并继续</button>
      <button class="privacy-sheet__decline" bindtap="onPrivacyDecline">暂不使用</button>
    </view>
  </view>
</view>
