.capture-page {
  padding-top: 24rpx;
}

.capture-copy {
  padding: 8rpx 2rpx 0;
}

.capture-title {
  color: #202124;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -1.5rpx;
}

.capture-sub {
  margin-top: 14rpx;
  color: #8a8a8a;
  font-size: 27rpx;
  line-height: 1.5;
}

.photo-wrap {
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 56rpx;
  background: #f6f6f6;
  box-shadow: 0 8rpx 48rpx rgba(0, 0, 0, 0.035),
    0 24rpx 96rpx rgba(0, 0, 0, 0.025);
}

.photo {
  width: 100%;
  height: 58vh;
  min-height: 520rpx;
  max-height: 820rpx;
  background: #f6f6f6;
}

.photo-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 54vh;
  margin-top: 36rpx;
  padding: 56rpx 32rpx;
  border-radius: 56rpx;
  background: #fafafa;
  text-align: center;
}

.photo-state--error {
  background: #fdf5f4;
  box-shadow: none;
}

.photo-state__title {
  margin-top: 26rpx;
  color: #202124;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.photo-state--error .photo-state__title {
  margin-top: 0;
  color: #b3261e;
  font-size: 29rpx;
  font-weight: 500;
}

.photo-state__desc {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 1.6;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  max-width: 520rpx;
  margin-top: 32rpx;
}

.actions {
  margin-top: 32rpx;
}

.analyze-btn {
  width: 100%;
}

.btn--pressed {
  opacity: 0.86;
}

.retake {
  width: 100%;
  min-height: 84rpx;
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 26rpx;
  line-height: 84rpx;
  text-align: center;
}

.retake:active {
  opacity: 0.56;
}

.capture-privacy {
  margin-top: 40rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(0, 0, 0, 0.28);
}

.privacy-sheet {
  width: 100%;
  max-width: 680rpx;
  padding: 42rpx 34rpx 24rpx;
  border-radius: 64rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 96rpx rgba(0, 0, 0, 0.16);
}

.privacy-sheet__title {
  color: #202124;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

.privacy-sheet__text {
  margin-top: 18rpx;
  color: #8a8a8a;
  font-size: 27rpx;
  line-height: 1.7;
}

.privacy-sheet__link {
  min-height: 68rpx;
  margin-top: 18rpx;
  color: #8a8a8a;
  font-size: 24rpx;
  line-height: 68rpx;
  text-align: left;
}

.privacy-sheet__agree {
  width: 100%;
  margin-top: 16rpx;
}

.privacy-sheet__decline {
  width: 100%;
  min-height: 80rpx;
  margin-top: 8rpx;
  color: #b0b0b0;
  font-size: 26rpx;
  line-height: 80rpx;
  text-align: center;
}

@media (max-height: 680px) {
  .photo {
    height: 50vh;
    min-height: 400rpx;
  }

  .photo-state {
    min-height: 46vh;
  }
}
