.state-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 24rpx;
}

.state-center {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 16rpx;
  text-align: center;
}

.state-title {
  margin-top: 32rpx;
  color: #202124;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
}

.state-message {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: #8a8a8a;
  font-size: 27rpx;
  line-height: 1.65;
}

.state-help {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.55;
}

.state-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  max-width: 560rpx;
  margin-top: 48rpx;
}

.state-privacy {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  color: #b0b0b0;
  font-size: 23rpx;
  text-align: center;
}

.result-page {
  padding-top: 24rpx;
}

.result-head {
  padding: 4rpx 2rpx 0;
}

.result-meta {
  color: #8a8a8a;
  font-size: 23rpx;
  font-weight: 500;
}

.result-title {
  margin-top: 14rpx;
  color: #202124;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.26;
  letter-spacing: -1.5rpx;
}

.result-subline {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.result-confidence {
  color: #b0b0b0;
  font-size: 22rpx;
}

.result-summary {
  margin-top: 36rpx;
  color: #202124;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.65;
  letter-spacing: -0.2rpx;
}

.metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 48rpx;
}

.metric {
  flex: 1;
  min-width: 0;
}

.metric--center {
  text-align: center;
}

.metric--right {
  text-align: right;
}

.metric__label {
  color: #8a8a8a;
  font-size: 23rpx;
  font-weight: 500;
}

.metric__value {
  margin-top: 8rpx;
  color: #202124;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: -1.5rpx;
}

.metric__unit {
  margin-top: 4rpx;
  color: #b0b0b0;
  font-size: 21rpx;
}

.metric-note {
  margin-top: 16rpx;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.5;
}

.voice-section {
  margin-top: 40rpx;
}

.caution-section {
  margin-top: 44rpx;
}

.section-label {
  color: #8a8a8a;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.caution-line {
  margin-top: 12rpx;
  color: #5f6368;
  font-size: 25rpx;
  line-height: 1.65;
}

.next-section {
  margin-top: 44rpx;
}

.next-body {
  color: #202124;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.7;
}

.suggestion-list {
  margin-top: 22rpx;
}

.suggestion {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.suggestion + .suggestion {
  margin-top: 14rpx;
}

.suggestion__dot {
  flex: 0 0 auto;
  width: 6rpx;
  height: 6rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #b0b0b0;
}

.suggestion__text {
  flex: 1;
  color: #5f6368;
  font-size: 25rpx;
  line-height: 1.65;
}

.activity-note {
  margin-top: 24rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1.6;
}

.disclosure {
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 48rpx;
  background: #fafafa;
}

.disclosure-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 94rpx;
  gap: 20rpx;
  padding: 0 28rpx;
  color: #202124;
  text-align: left;
}

.disclosure-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.disclosure-count {
  color: #b0b0b0;
  font-size: 22rpx;
  font-weight: 400;
}

.disclosure-action {
  flex: 0 0 auto;
  color: #8a8a8a;
  font-size: 23rpx;
}

.disclosure-body {
  padding: 0 28rpx 28rpx;
}

.food-row {
  padding: 18rpx 0;
}

.food-row__main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.food-row__name {
  color: #202124;
  font-size: 28rpx;
  font-weight: 500;
}

.food-row__category {
  color: #b0b0b0;
  font-size: 21rpx;
}

.food-row__meta {
  margin-top: 4rpx;
  color: #8a8a8a;
  font-size: 23rpx;
}

.food-row__note {
  margin-top: 6rpx;
  color: #b0b0b0;
  font-size: 22rpx;
  line-height: 1.55;
}

.method-text,
.warning-line {
  margin-top: 14rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1.65;
}

.method-text {
  margin-top: 0;
}

.warning-line {
  padding-left: 18rpx;
  position: relative;
}

.warning-line::before {
  content: "·";
  position: absolute;
  left: 0;
  color: #c8c8c8;
}

.timing {
  margin-top: 16rpx;
  color: #b0b0b0;
  font-size: 21rpx;
  line-height: 1.5;
}

.disclaimer {
  margin: 32rpx 4rpx 0;
  color: #b0b0b0;
  font-size: 23rpx;
  line-height: 1.6;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 40rpx;
}

.delete-link {
  width: 100%;
  min-height: 76rpx;
  margin-top: 4rpx;
  color: #b3261e;
  font-size: 24rpx;
  line-height: 76rpx;
  text-align: center;
}

.delete-link:active {
  opacity: 0.6;
}
