<view wx:if="{{state === 'loading'}}" class="page state-page">
  <view wx:if="{{isDemoMode}}" class="demo-banner">演示模式 · 不会调用真实分析</view>
  <view class="state-center">
    <view class="loading-dots">
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
      <view class="loading-dots__dot"></view>
    </view>
    <view class="state-title">{{stageText}}</view>
  </view>
  <view class="state-privacy">照片仅用于当次分析，完成后删除。</view>
</view>

<view wx:elif="{{state === 'error'}}" class="page state-page">
  <view class="state-center">
    <view class="state-title">{{errorTitle}}</view>
    <view class="state-message">{{errorMessage}}</view>
    <view class="state-help">换一张光线更好的照片，通常会更准。</view>
    <view class="state-actions">
      <button wx:if="{{errorCanRetry}}" class="btn btn-primary" bindtap="onRetry">再试一次</button>
      <button wx:if="{{errorCanCamera}}" class="btn btn-secondary" bindtap="onRetake">换一张照片</button>
      <button class="btn btn-ghost" bindtap="onBackToday">返回</button>
    </view>
  </view>
</view>

<view wx:else class="page result-page">
  <view wx:if="{{isDemoMode || meal.source === 'mock'}}" class="demo-banner">
    演示数据 · 不代表真实分析
  </view>

  <view class="result-head">
    <view class="result-meta">{{meta.dateLabel}} · {{meta.typeLabel}} · {{meta.timeLabel}}</view>
    <view class="result-title">{{meal.mealName}}</view>
    <view class="result-subline">
      <demo-badge source="{{meal.source}}" />
      <text class="result-confidence">{{meta.confidence}}</text>
    </view>
  </view>

  <view class="result-summary">{{meal.assessment}}</view>

  <view class="metrics">
    <view class="metric">
      <view class="metric__label">热量</view>
      <view class="metric__value">{{meta.calories}}</view>
      <view class="metric__unit">千卡</view>
    </view>
    <view class="metric metric--center">
      <view class="metric__label">蛋白质</view>
      <view class="metric__value">{{meta.protein}}</view>
      <view class="metric__unit">克</view>
    </view>
    <view class="metric metric--right">
      <view class="metric__label">脂肪</view>
      <view class="metric__value">{{meta.fat}}</view>
      <view class="metric__unit">克</view>
    </view>
  </view>
  <view class="metric-note">估算区间，非精确测量。</view>

  <view class="voice-section">
    <voice-player meal-id="{{meal.id}}" revision="{{voiceRevision}}" />
  </view>

  <view wx:if="{{cautions.length > 0}}" class="caution-section">
    <view class="section-label">油盐</view>
    <view wx:for="{{cautions}}" wx:key="key" class="caution-line">{{item.message}}</view>
  </view>

  <view class="next-section">
    <section-card title="下一餐">
      <view class="next-body">{{meal.nextMeal}}</view>
      <view class="suggestion-list">
        <view wx:for="{{meal.suggestions}}" wx:key="*this" class="suggestion">
          <view class="suggestion__dot"></view>
          <text class="suggestion__text">{{item}}</text>
        </view>
      </view>
      <view class="activity-note">{{meal.activitySuggestion}}</view>
    </section-card>
  </view>

  <view class="disclosure">
    <button class="disclosure-row" bindtap="onToggleFoods">
      <view class="disclosure-title">
        <text>识别明细</text>
        <text class="disclosure-count">{{foods.length}}</text>
      </view>
      <text class="disclosure-action">{{showFoods ? '收起' : '展开'}}</text>
    </button>
    <view wx:if="{{showFoods}}" class="disclosure-body">
      <view wx:for="{{foods}}" wx:key="id" class="food-row">
        <view class="food-row__main">
          <text class="food-row__name">{{item.name}}</text>
          <text class="food-row__category">{{item.categoryLabel}}</text>
        </view>
        <view class="food-row__meta">{{item.portionText}}</view>
        <view wx:if="{{item.matchedText}}" class="food-row__note">{{item.matchedText}}</view>
        <view wx:if="{{item.note}}" class="food-row__note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view class="disclosure">
    <button class="disclosure-row" bindtap="onToggleDetails">
      <text class="disclosure-title">说明</text>
      <text class="disclosure-action">{{showDetails ? '收起' : '展开'}}</text>
    </button>
    <view wx:if="{{showDetails}}" class="disclosure-body">
      <view class="method-text">{{methodText}}</view>
      <view wx:for="{{warnings}}" wx:key="*this" class="warning-line">{{item}}</view>
      <view wx:if="{{meta.timingText}}" class="timing">{{meta.timingText}}</view>
    </view>
  </view>

  <view class="disclaimer">{{meal.disclaimer}}</view>

  <view class="result-actions">
    <button class="btn btn-primary" bindtap="onEdit">调整食物</button>
    <button class="btn btn-secondary" bindtap="onBackToday">回到今天</button>
    <button class="delete-link" bindtap="onDelete">删除记录</button>
  </view>
</view>
